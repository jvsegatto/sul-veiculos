# Cloudflare R2 — armazenamento das fotos de veículo (egress grátis).
# Usadas só em app/api/upload e lib/uploads/r2.ts (server-only) — nunca
# prefixar com NEXT_PUBLIC_, senão o secret vaza pro bundle do client.

# ID da conta Cloudflare (painel R2 > conta) — usado pra montar o endpoint
# S3-compatible: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Credenciais do token de API R2 (painel R2 > Manage API Tokens), com
# permissão de leitura/escrita no bucket abaixo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket R2 onde as fotos (full + thumb) são salvas.
R2_BUCKET=

# Domínio público de leitura do bucket (domínio customizado conectado ao R2,
# ou a URL pública padrão r2.dev) — SEM barra no final. A URL final de cada
# foto é R2_PUBLIC_BASE_URL + "/" + key.
R2_PUBLIC_BASE_URL=
